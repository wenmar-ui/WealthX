# ─────────────────────────────────────────────────────────────────
# WealthXcelerate Environment Variables — EXAMPLE FILE
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# Section 2: Public ID vs. Private Key Isolation
# These are safe to expose — they only load UI widgets, not grant account access.
VITE_GHL_WIDGET_ID=your_widget_id_here
VITE_GHL_LOCATION_ID=your_location_id_here

# Any truly private keys (API secrets, webhooks) must NEVER go here.
# They belong only in your hosting provider's server-side environment variables.
